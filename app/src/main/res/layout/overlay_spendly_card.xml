<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/overlay_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_overlay_card"
        android:elevation="16dp">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_app_icon"
                android:scaleType="centerCrop" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Spendly Auto-Capture"
                android:textColor="#A09E97"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/overlay_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_notification_pill"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="PAID"
                android:textColor="#FDFBF7"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Hero Amount & Payee Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/overlay_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹450.00"
                android:textColor="#FDFBF7"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/overlay_merchant"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="3dp"
                android:text="to Starbucks"
                android:textColor="#C8C5BD"
                android:textSize="15sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Details Metadata Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/overlay_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Food &amp; Dining"
                android:textColor="#FDFBF7"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" • "
                android:textColor="#555555"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/overlay_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PhonePe"
                android:textColor="#A09E97"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/overlay_ref"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Ref: 4296..."
                android:textColor="#666666"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Action Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp"
            android:gravity="end">

            <!-- Undo Button -->
            <TextView
                android:id="@+id/overlay_btn_undo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_notification_btn_secondary"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="Undo"
                android:textColor="#FDFBF7"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <!-- Edit Expense Button -->
            <TextView
                android:id="@+id/overlay_btn_edit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_notification_btn"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="Edit Details"
                android:textColor="#000000"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
