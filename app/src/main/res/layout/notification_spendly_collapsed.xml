<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="@drawable/bg_notification_card">

    <!-- App Logo Icon -->
    <ImageView
        android:id="@+id/notif_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginEnd="12dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_app_icon" />

    <!-- Text Information -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Title / Amount Line -->
        <TextView
            android:id="@+id/notif_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paid ₹450.00"
            android:textColor="#FDFBF7"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Subtitle: Category & Context -->
        <TextView
            android:id="@+id/notif_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Food &amp; Dining • Spendly"
            android:textColor="#A09E97"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Monochrome Pill Badge -->
    <TextView
        android:id="@+id/notif_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_notification_pill"
        android:paddingStart="9dp"
        android:paddingEnd="9dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="PAID"
        android:textColor="#FDFBF7"
        android:textSize="10sp"
        android:textStyle="bold" />
</LinearLayout>
